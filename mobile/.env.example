# Optional override for the backend base URL used by the mobile app.
# If unset, the app derives the host from the Expo dev server and uses port 3000
# (falling back to http://localhost:3000 on the iOS simulator).
#
# Set this when your phone can't reach the derived LAN IP, or to point at a
# tunnel / staging backend. Must include scheme + host + port, no trailing /api.
# EXPO_PUBLIC_API_URL=http://192.168.1.5:3000
