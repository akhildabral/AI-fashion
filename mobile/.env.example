# Backend origin the app talks to. Leave unset in development: the app derives
# the LAN host from the Expo dev server and uses port 3000 (the iOS simulator
# falls back to http://localhost:3000). Must include scheme + host + port and
# no trailing /api.
# EXPO_PUBLIC_API_URL=http://192.168.1.5:3000

# Google Sign-In (Google Cloud console > OAuth client IDs). The iOS URL scheme
# is the reversed iOS client ID. The web client ID is what the backend verifies
# the id token against on iOS and Android too.
# GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.1234567890-abc
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-def.apps.googleusercontent.com

# Sentry (crashes and release health). Source maps upload through EAS.
# SENTRY_ORG=zauq
# SENTRY_PROJECT=zauq-mobile
# EXPO_PUBLIC_SENTRY_DSN=https://...@o0.ingest.sentry.io/0

# EAS project (from `eas init`), also enables expo-updates.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
