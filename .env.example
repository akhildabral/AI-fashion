# ---- Postgres (used by docker-compose) ----
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion
POSTGRES_DB=ai_fashion
# Host port for Postgres. Uses 5433 to avoid clashing with a local Postgres on 5432.
POSTGRES_PORT=5433

# Connection string for the backend (matches POSTGRES_PORT above)
DATABASE_URL=postgresql://fashion:fashion@localhost:5433/ai_fashion

# ---- App secrets ----
# JWT signing secret for auth (generate a long random string)
JWT_SECRET=change-me

# ---- AI provider (agnostic) ----
# Chat/vision provider for tagging, suggestions, and stylist plans:
#   openai | openrouter | anthropic | bedrock | custom
AI_PROVIDER=openai
# API key for that provider (bedrock uses AWS credentials + AWS_REGION instead).
AI_API_KEY=your-api-key
# Model in the provider's naming; empty = a sensible default per provider.
# Examples: gpt-4o-mini · openai/gpt-4o-mini (openrouter) · claude-haiku-4-5
#           us.anthropic.claude-haiku-4-5-20251001-v1:0 (bedrock)
#TEXT_MODEL=
# Base URL — required for custom, optional override for openai/openrouter.
#AI_BASE_URL=
# Required for bedrock:
#AWS_REGION=us-east-1

# ---- Image generation (look rendering + virtual try-on) ----
# auto resolves per AI_PROVIDER: openai → the OpenAI /images API,
# openrouter/custom → an image-capable chat model (e.g. Gemini image),
# anthropic/bedrock → none (pair with IMAGE_PROVIDER=chat + IMAGE_API_KEY
# to enable images alongside a Claude text provider).
IMAGE_PROVIDER=auto
# Empty = gpt-image-1 (openai) / google/gemini-2.5-flash-image (chat).
#IMAGE_MODEL=
# Only when images use different credentials/endpoint than the text provider:
#IMAGE_API_KEY=
#IMAGE_BASE_URL=
# Quality tier for gpt-image models — drives cost.
IMAGE_QUALITY=medium

# ---- Cataloging pipeline (optional; defaults shown) ----
# Local matting model gives wardrobe uploads a clean, cropped cutout for ~free.
# The model is downloaded on first use (isnet-general-use ≈ 170 MB).
MATTING_ENABLED=true
# isnet-general-use (default, high quality) | u2net | u2netp (small/weak)
MATTING_MODEL=isnet-general-use
# Display-image cleanup strategy (the original photo is ALWAYS kept, and the
# UI can toggle between original and cleaned):
#   auto       — generative white-studio shot when an image provider is
#                configured (one edit per upload), else local matting
#   generative — always the white-studio product shot
#   local      — free local matting cutout only
#   off        — show the original photo as-is
CLEANUP_MODE=auto

# ---- Image storage (optional) ----
# local (default): files on disk under UPLOADS_DIR, served at /api/uploads.
# s3: S3-compatible object storage (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
# Required when STORAGE_DRIVER=s3:
#S3_BUCKET=ai-fashion
#S3_REGION=auto
#S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#S3_PUBLIC_URL=https://images.example.com
#S3_ACCESS_KEY_ID=...
#S3_SECRET_ACCESS_KEY=...
