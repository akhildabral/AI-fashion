# ---- Postgres (used by docker-compose) ----
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion
POSTGRES_DB=ai_fashion
# Host port for Postgres. Uses 5433 to avoid clashing with a local Postgres on 5432.
POSTGRES_PORT=5433

# Connection string for the backend (matches POSTGRES_PORT above)
DATABASE_URL=postgresql://fashion:fashion@localhost:5433/ai_fashion

# ---- App secrets ----
# JWT signing secret for auth (generate a long random string)
JWT_SECRET=change-me

# ---- AI provider (OpenAI: used for both text and images) ----
OPENAI_API_KEY=your-openai-key
# Image model + quality (optional; sensible defaults shown).
# gpt-image-1 returns base64 (served as a data URL). Use dall-e-3 if your key has it.
IMAGE_MODEL=gpt-image-1
IMAGE_QUALITY=medium
