# ---- Postgres (used by docker-compose) ----
POSTGRES_USER=fashion
POSTGRES_PASSWORD=fashion
POSTGRES_DB=ai_fashion
POSTGRES_PORT=5432

# Connection string for the backend
DATABASE_URL=postgresql://fashion:fashion@localhost:5432/ai_fashion

# ---- App secrets ----
# JWT signing secret for auth (generate a long random string)
JWT_SECRET=change-me

# ---- AI providers ----
OPENAI_API_KEY=your-openai-key
NEBIUS_API_KEY=your-nebius-key
