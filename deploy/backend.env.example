# Backend secrets & config — copy to deploy/backend.env (gitignored).
# DATABASE_URL is injected by docker-compose; do not set it here.

# JWT signing secret: generate with  openssl rand -hex 32
JWT_SECRET=change-me

# ---- AI provider (agnostic) ----
# openai | openrouter | anthropic | bedrock | custom
AI_PROVIDER=openrouter
AI_API_KEY=your-key
TEXT_MODEL=openai/gpt-4o-mini

# ---- Image generation ----
IMAGE_PROVIDER=auto
IMAGE_MODEL=google/gemini-2.5-flash-image
IMAGE_QUALITY=medium

# ---- Cataloging ----
MATTING_ENABLED=true
MATTING_MODEL=isnet-general-use

# ---- Storage ----
# Local disk on the VPS (persisted via the uploads volume).
STORAGE_DRIVER=local

# ---- Access control (waitlist) ----
# Comma-separated emails auto-approved as admins (the superuser bootstrap).
ADMIN_EMAILS=you@example.com
# SMTP for verification emails (optional — without it, links are logged
# to the backend console; docker compose logs backend | grep mailer).
#SMTP_HOST=smtp-relay.brevo.com
#SMTP_PORT=587
#SMTP_USER=...
#SMTP_PASS=...
#SMTP_FROM=ZAUQ <no-reply@your.domain>
# Comma-separated allowed browser origins (recommended in production).
#CORS_ORIGINS=https://fashion.conflict-monitor.com

# ---- Sign-in (web + the phone app) ----
# Google OAuth client IDs the id-token audience may be: web first, then the
# iOS and Android clients of the app. GOOGLE_CLIENT_ID (single) still works.
#GOOGLE_CLIENT_IDS=123-web.apps.googleusercontent.com,123-ios.apps.googleusercontent.com,123-android.apps.googleusercontent.com
# Sign in with Apple: the app's bundle identifier(s).
#APPLE_BUNDLE_IDS=com.myzauq.app

# ---- Push ----
# Web push (VAPID keys: npx web-push generate-vapid-keys). Native push goes
# through Expo's service and needs no keys; an access token is optional.
#VAPID_PUBLIC_KEY=...
#VAPID_PRIVATE_KEY=...
#VAPID_SUBJECT=mailto:you@example.com
#EXPO_ACCESS_TOKEN=...

# ---- The phone app ----
# Builds older than this are asked to update (semver).
MIN_SUPPORTED_CLIENT=1.0.0

# ---- Billing (Razorpay) ----
# Plan limits live in code (entitlements.service.ts): free 15 items/10 looks/
# 5 try-ons lifetime; plus 100/30/30 monthly; pro 500/100/100 monthly.
# Billing endpoints return 503 until these are set.
#RAZORPAY_KEY_ID=rzp_live_...
#RAZORPAY_KEY_SECRET=...
# Webhook secret you choose when creating the webhook in the Razorpay
# dashboard (URL: https://<domain>/api/billing/webhook).
#RAZORPAY_WEBHOOK_SECRET=...
# Create the plans once with: pnpm exec tsx scripts/razorpay-setup.ts
#RAZORPAY_PLAN_PLUS=plan_...
#RAZORPAY_PLAN_PRO=plan_...

# ---- Sessions & logging ----
# Access-token lifetime for web sessions that opt into refresh tokens
# (`client: 'web'` on sign-in). Stays 7d until the web frontend uses
# /auth/refresh; switch to 1h then. Legacy sessions keep JWT_EXPIRES_IN.
#JWT_EXPIRES_IN_WEB=7d
# pino log level: fatal | error | warn | info | debug | trace
#LOG_LEVEL=info
