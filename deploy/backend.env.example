# Backend secrets & config — copy to deploy/backend.env (gitignored).
# DATABASE_URL is injected by docker-compose; do not set it here.

# JWT signing secret: generate with  openssl rand -hex 32
JWT_SECRET=change-me

# ---- AI provider (agnostic) ----
# openai | openrouter | anthropic | bedrock | custom
AI_PROVIDER=openrouter
AI_API_KEY=your-key
TEXT_MODEL=openai/gpt-4o-mini

# ---- Image generation ----
IMAGE_PROVIDER=auto
IMAGE_MODEL=google/gemini-2.5-flash-image
IMAGE_QUALITY=medium

# ---- Cataloging ----
MATTING_ENABLED=true
MATTING_MODEL=isnet-general-use

# ---- Storage ----
# Local disk on the VPS (persisted via the uploads volume).
STORAGE_DRIVER=local
