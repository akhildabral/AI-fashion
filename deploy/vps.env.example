# Compose-level settings — copy to .env.prod next to docker-compose.prod.yml.

# A long random password for the Postgres container (internal only).
POSTGRES_PASSWORD=change-me-long-random

# Your domain (A record pointing at the VPS). Caddy gets HTTPS automatically.
# For a local smoke test of the prod stack use ":8080" instead.
SITE_ADDRESS=app.example.com

# Public URL of the site. deploy.sh probes $PUBLIC_ORIGIN/ and
# $PUBLIC_ORIGIN/api/health after every deploy and fails the deploy if they
# do not answer. Leave unset to skip the probe (local smoke tests).
PUBLIC_ORIGIN=https://app.example.com
