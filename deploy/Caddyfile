# SITE_ADDRESS examples:
#   app.example.com            → automatic HTTPS via Let's Encrypt (production)
#   "a.example.com, b.example.com" → one app on several hostnames
#   :8080                      → plain HTTP (local smoke test of the prod stack)
{$SITE_ADDRESS} {
	encode zstd gzip

	# Baseline security headers on every response. Clickjacking off, no
	# referrer leakage of tokened URLs, HSTS, MIME sniffing off, tight
	# permissions, and the server banner removed. (The strict CSP is scoped
	# to the SPA below — the backend-served /vote & /look pages carry their
	# own nonce'd CSP, so a blanket policy must not clobber them.)
	header {
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(self)"
		-Server
	}

	# API (including /api/uploads images and /api/quiz-assets).
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Public share pages (verdicts, looks) are served by the backend itself.
	handle /vote/* {
		reverse_proxy backend:3000
	}
	handle /look/* {
		reverse_proxy backend:3000
	}

	# The SPA — client-side routing falls back to index.html.
	handle {
		# The app holds the bearer token, so its CSP is the real containment
		# for any injection: scripts only from us + the payment/SSO SDKs, no
		# framing, images over https, connections to us + Google SSO.
		header Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com https://accounts.google.com; frame-src https://api.razorpay.com https://checkout.razorpay.com https://accounts.google.com; connect-src 'self' https://accounts.google.com https://lumberjack.razorpay.com; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com; font-src https://fonts.gstatic.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}

# Server-specific extra sites (mounted from deploy/extra-sites; untracked
# *.caddy files there survive CI redeploys).
import /etc/caddy/extra/*.caddy
