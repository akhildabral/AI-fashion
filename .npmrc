# pnpm's default isolated layout: the web app (React 18) and the phone app
# (React 19) each resolve their own peers precisely. Metro follows the
# symlinks (see mobile/metro.config.js), so nothing needs hoisting.
strict-peer-dependencies=false

# The two React majors mean two @types/react. Libraries whose .d.ts files
# import 'react' find the types by walking up, so keep @types/react out of
# pnpm's hidden hoist dir: the phone app's copy lives at the workspace root
# (root devDependency), and the web app pins its own through tsconfig paths.
hoist-pattern[]=*
hoist-pattern[]=!@types/react
hoist-pattern[]=!@types/react-dom
