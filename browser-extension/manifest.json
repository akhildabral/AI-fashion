{
  "manifest_version": 3,
  "name": "ZAUQ — Ask the closet",
  "short_name": "ZAUQ",
  "version": "0.1.0",
  "description": "On any shop page, ask the closet whether the piece belongs with what you already own.",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Ask the closet about this piece",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ask-the-closet@myzauq.com",
      "strict_min_version": "109.0"
    }
  }
}
