// Prisma schema for ZAUQ
// Phase 0 foundation: users, style profiles, and generated looks.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  // Null for waitlist entries and Google-only accounts.
  passwordHash String?
  googleId     String?       @unique
  // Sign in with Apple: the stable per-app user id from the identity token.
  appleSub     String?       @unique
  firstName    String?
  lastName     String?
  // Invite-only onboarding: token emailed/copied by an admin.
  inviteToken        String?   @unique
  inviteTokenExpires DateTime?
  // Forgotten password: a one-hour link by email.
  resetToken         String?   @unique
  resetTokenExpires  DateTime?
  // Public username for the community layer (lowercase, unique). Null until chosen.
  handle       String?       @unique
  // The door: every member holds a few invites. inviteCode is their standing
  // link (/join/:code), invitesLeft counts down, invitedById records who let
  // them in. Admins are never limited.
  inviteCode   String?       @unique
  invitesLeft  Int           @default(5)
  invitedById  String?
  // Access control: the app is waitlist-gated. New accounts are pending
  // until email-verified AND approved by an admin.
  //   status: pending | approved | suspended
  role         String        @default("user")
  status       String        @default("pending")
  emailVerified Boolean      @default(false)
  verifyToken  String?       @unique
  verifyTokenExpires DateTime?
  // Bumped to invalidate every issued JWT at once — on logout, password reset,
  // or suspension. The token carries the version it was minted at.
  tokenVersion Int           @default(0)
  // Billing: which tier the account is on and what the gateway knows.
  //   plan: free | plus | pro | founder   planStatus: none | active | grace | cancelled
  plan         String        @default("free")
  planStatus   String        @default("none")
  currentPeriodEnd      DateTime?
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  // Relative path to the user's uploaded body photo (for virtual try-on).
  photoPath    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  profile StyleProfile?
  looks   Look[]
  tryOns  TryOn[]
  wardrobe WardrobeItem[]
  wearPhotos WearPhotoJob[]
  outfits  Outfit[]
  wearLogs WearLog[]
  polls    Poll[]
  following     Follow[]     @relation("following")
  followers     Follow[]     @relation("followers")
  picksReceived FriendPick[] @relation("picksFor")
  picksSent     FriendPick[] @relation("picksBy")
  usageEvents   UsageEvent[]
  billingEvents BillingEvent[]
  dailyBriefs   DailyBrief[]
  trips         Trip[]
  lookbooks     Lookbook[]
  reactions         Reaction[]
  notifications     Notification[] @relation("notificationsFor")
  notificationsSent Notification[] @relation("notificationsBy")
  comments          Comment[]
  savedLooks        SavedLook[]
  pushSubscriptions PushSubscription[]
  sessions          Session[]
  photos       UserPhoto[]
  invitedBy    User?         @relation("invitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees     User[]        @relation("invitedBy")
  blocks       Block[]       @relation("blocker")
  blockedBy    Block[]       @relation("blocked")
  mutes        Mute[]        @relation("muter")
  mutedBy      Mute[]        @relation("muted")
  reports      Report[]
  styleEvents  StyleEvent[]
  tasteProfile TasteProfile?
}

// Safety. A block is invisible both ways: neither sees the other anywhere,
// and every follow between them is removed. A mute is one way and quiet:
// their posts leave your table until `until` (null = for good).
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Mute {
  id        String    @id @default(uuid())
  muterId   String
  muter     User      @relation("muter", fields: [muterId], references: [id], onDelete: Cascade)
  mutedId   String
  muted     User      @relation("muted", fields: [mutedId], references: [id], onDelete: Cascade)
  until     DateTime?
  createdAt DateTime  @default(now())

  @@unique([muterId, mutedId])
}

// Something a member flagged for the house to look at.
//   targetType: user | look | verdict | pick | comment
model Report {
  id         String    @id @default(uuid())
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  detail     String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt, createdAt])
}

// A browser that asked to be woken for the morning ritual. One row per
// device; the hour and zone are the person's, so the nudge lands at their
// morning wherever the server is.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // web (browser, VAPID) | ios | android (Expo push). Native rows keep
  // endpoint = "expo:" + expoToken so the unique key and every existing
  // code path keep working; p256dh/auth are web-only.
  platform  String   @default("web")
  endpoint  String   @unique
  expoToken String?  @unique
  p256dh    String?
  auth      String?
  timezone  String   @default("UTC")
  hour      Int      @default(7)
  // "Laid out for tomorrow" at eight in the evening, if wanted.
  eveningPush Boolean @default(false)
  // Event pushes (native only): circle activity, and renders finishing.
  eventsCircle  Boolean @default(true)
  eventsRenders Boolean @default(true)
  lastEveningOn String?
  lastSentOn String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// A signed-in device. The refresh token is opaque and stored hashed; each
// use rotates it (the old row is revoked, a new one written), so a stolen
// token that gets replayed is caught. Logging out one device revokes its
// row only; a password reset or suspension revokes them all.
model Session {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  platform   String    @default("mobile")
  deviceName String?
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// A short styling note on a shared look or a verdict. Plain text; @handles
// in the body mention people (they're notified).
//   targetType: look (wearLogId) | verdict (pollId)
model Comment {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  body       String
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@index([userId])
}

// Your inspiration board: shared looks you've kept.
model SavedLook {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wearLogId String
  wearLog   WearLog  @relation(fields: [wearLogId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, wearLogId])
}

// A garment the user owns, photographed and auto-tagged by a vision model.
model WardrobeItem {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  imageUrl     String
  // The untouched upload. Cleanup writes cutouts to imageUrl but never
  // replaces this — reprocessing must always start from pristine pixels.
  originalUrl  String?
  // Async cataloging pipeline state: processing | ready | failed.
  status       String   @default("ready")
  category     String
  subtype      String?
  primaryColor String?
  pattern      String?
  formality    String?
  season       String[]
  material     String?
  description  String?
  // Reasoning attributes (plan §5.1). Warmth and layer role are derived from
  // deterministic lookup tables, never free-generated by a model.
  formalityScore Int?
  warmthValue    Int?
  layerRole      String?
  // Availability: clean | in-wash | packed | lent-out | retired.
  state          String  @default("clean")
  // "Don't suggest this" — hidden from suggestion pools but kept in the closet.
  suppressed     Boolean @default(false)
  // Community visibility: private (default) | public. Public items appear on
  // the owner's profile; everything else stays theirs alone.
  visibility     String  @default("private")
  // Dominant-first palette: [{ hex, lab: { L, a, b }, share }].
  colorPalette   Json?
  // Per-attribute model confidence (0–1); low-confidence fields stay null.
  attrConfidence Json?
  // What the item cost — powers cost-per-wear. Currency-agnostic number.
  price          Float?
  // Hook for canonical product-catalog resolution — populated in a later phase.
  // The basket: wears since the last wash, flipped to in-wash by garment rule.
  wearsSinceWash Int       @default(0)
  washedAt       DateTime?
  // A wishlist piece is a piece the closet knows you don't own yet.
  owned          Boolean   @default(true)
  seenAt         DateTime?
  seenPrice      Int?
  store          String?
  nudgeAt        DateTime?
  // Cached in-store verdict: { outfits, pairs, closest, unlock, computedAt }.
  verdict        Json?
  brand          String?
  size           String?
  productId      String?
  // Tags, second edition. cutFor: womens | mens | unisex — the line the
  // stylist never crosses. The rest describe proportion and make.
  cutFor         String?
  secondaryColor String?
  fit            String?
  length         String?
  texture        String?
  weight         String?
  occasions      String[]  @default([])
  // Per-type details: { neckline, sleeve, rise, leg, heel, toe, closure, materialNote }.
  details        Json?
  note           String?
  care           String?
  // For the Mirror: a precise visual description an image model can dress
  // someone in — shade, fabric, collar, closures, every logo and print.
  renderNotes    String?
  // True when originalUrl is this piece's own crop out of a group photo —
  // its source from then on; a re-read starts from it as a single garment.
  cropped        Boolean   @default(false)
  // A twin: this piece looks like one already in the closet. Flagged on
  // arrival, never acted on alone; resolved by the person as same or
  // different. twinDismissed remembers pairs judged different.
  twinOfId       String?
  twinScore      Float?
  twinResolvedAt DateTime?
  twinDismissed  String[]  @default([])
  // A 64-bit difference hash of the cut-out, hex: the same photo again.
  fingerprint    String?
  // Colour harmony, derived from the palette at catalog time (derived on read
  // for older rows). colourFamily: red | orange | yellow | green | teal | blue |
  // violet | pink | brown | neutral. colourVividness: muted | mid | vivid.
  colourFamily    String?
  colourVividness String?
  // Wearability, second edition. patternScale: none | fine | medium | bold.
  // dressCode: athleisure | casual | smart-casual | business-casual | business |
  // cocktail | formal. needsLayer is the union of the model's opinion and the
  // derived floor. shoeType, footwear only: sneaker | trainer | sandal |
  // flip-flop | loafer | boot | oxford | derby | heel | pump | mule | other.
  patternScale    String?
  sheer           Boolean?
  dressCode       String?
  needsLayer      Boolean?
  shoeType        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt @default(now())

  @@index([userId])
  // Already created by 20260905090000_closet_rooms; declared here so the
  // schema and the migration history agree (the wishlist filters on owned).
  @@index([userId, owned])
}

// A persistent outfit: a set of owned items, with provenance and wear history.
model Outfit {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Wardrobe item ids. Kept as a scalar list for speed; items may be deleted,
  // so readers must tolerate ids that no longer resolve.
  itemIds    String[]
  rationale  String?
  eventType  String   @default("work")
  // ai | user | copied
  provenance String   @default("ai")
  rating     Int?
  wearCount  Int      @default(0)
  createdAt  DateTime @default(now())

  wearLogs WearLog[]

  @@index([userId])
}

// The taste layer's raw material: every swap, correction, composition, rating
// and piece of feedback, as it happened. Read in bulk by the nightly derivation;
// never joined on a request path.
//   kind: swap | wore_instead | passed_over | composed | rated | feedback
model StyleEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  occurredOn DateTime @default(now())
  eventType  String?
  // Which look of the day (morning | afternoon | evening | custom).
  slot       String?
  // A swap: what left the look and what came in.
  outId      String?
  inId       String?
  itemIds    String[] @default([])
  outfitId   String?
  rating     Int?
  // Anything else worth keeping: { signal } for feedback, and so on.
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId, occurredOn])
}

// What the wear log says about how a member actually dresses, derived nightly
// and after a wear. Every column but the sample size is a JSON block the
// taste service owns; readers go through its hooks, never the shape.
model TasteProfile {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  computedAt       DateTime @default(now())
  sampleSize       Int      @default(0)
  colourAffinity   Json
  formalityOffset  Json
  pairAffinity     Json
  silhouette       Json
  shoeHabits       Json
  layering         Json
  favouriteOutfits Json
  facts            Json
  // Fact ids the member said "not quite" to; never shown again.
  dismissedFacts   String[] @default([])
}

// One worn-outfit record: the moat. What was worn, when, in what context.
model WearLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outfitId  String?
  outfit    Outfit?  @relation(fields: [outfitId], references: [id], onDelete: SetNull)
  itemIds   String[]
  wornOn    DateTime @default(now())
  eventType String?
  // Snapshot at log time: { temperatureC, description, location }.
  weather   Json?
  rating    Int?
  createdAt DateTime @default(now())

  @@index([userId, wornOn])
  // OOTD: set when the wearer shares this outfit to their circle.
  sharedAt  DateTime?
  // Explore: set by an admin to pin this shared outfit to the curated feed.
  featuredAt DateTime?
  // How many people have recreated this look from their own closet.
  recreatedCount Int @default(0)
  // Optional OOTD photo (uploaded, or a Mirror render) shown as the hero.
  photoUrl  String?
  savedBy   SavedLook[]
  // What the stylist had laid out that day, when the wearer logged something
  // else from a photo. The ranker reads the difference.
  suggestedItemIds String[] @default([])
  woreInstead      Boolean  @default(false)

  // The circle feed filters on sharedAt; Explore orders featured-first.
  @@index([sharedAt])
  @@index([featuredAt, sharedAt])
}

// A photo of the day being read: which of your pieces are in it, and which
// are new. Rows are the garments found; the wearer confirms each one.
model WearPhotoJob {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           String   // YYYY-MM-DD in the wearer's day
  photoUrl       String
  status         String   @default("processing") // processing | ready | confirmed | failed
  rows           Json?
  error          String?
  confirmedLogId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt @default(now())

  @@index([userId, date])
}

// A taste-relevant reaction on a shared look ("would wear", "bold", "love").
// One per person per look — this is signal, not a like count to farm.
// A reaction to any post — a look (wearLogId), a verdict (pollId) or a pick
// (pickId). One per person per post; kind: would_wear | bold | love.
model Reaction {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  kind       String
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([targetType, targetId])
}

// Things that happened to you. They live behind the bell, never in the
// feed, so the feed stays about looks.
//   type: new_follower | pick_received | pick_worn | look_reacted | look_recreated
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation("notificationsFor", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?     @relation("notificationsBy", fields: [actorId], references: [id], onDelete: SetNull)
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// A user's persistent style profile — the "brain" every recommendation builds on.
// Fields are nullable in Phase 0; the profile setup flow lands in Phase 1.
model StyleProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyType    String?
  heightCm    Int?
  sizes       Json?
  skinTone    String?
  styleVibe   String?
  budgetBand  String?
  avoidColors String[]
  // Taste-quiz output: { signals: string[], takenAt: ISO string }. Cold-start
  // personalization until the wear log takes over.
  styleSignals Json?
  // Home city for the daily brief's weather (optional).
  city        String?
  // Who we style for: female | male | unisex.
  styleFor    String?
  // ISO 4217 code the member keeps their books in (AED, INR, USD…).
  currency    String?
  // From the fitting: what matters most (decided | own | friends) and the
  // days they dress for (event types). Progress lets an abandoned fitting
  // resume from Today instead of resetting.
  intents            String[]  @default([])
  occasions          String[]  @default([])
  // metric | imperial — how heights and temperatures read to them.
  units              String?
  fittingStep        Int       @default(0)
  fittingCompletedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A generated outfit recommendation, persisted so it survives sessions.
model Look {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  occasion  String
  gender    String
  outfit    Json
  rationale String
  imageUrl  String?
  favorite  Boolean  @default(false)
  // Inspiration: kept, or thrown back ("keep" | "no"). Both teach the stylist.
  verdict   String?
  createdAt DateTime @default(now())

  tryOns TryOn[]

  @@index([userId])
}

// A virtual try-on: a saved look rendered onto the user's uploaded photo.
model TryOn {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Wardrobe items rendered in this try-on (empty for look-based try-ons) —
  // lets poll outcomes map back to items for ranking.
  itemIds   String[]
  lookId    String?
  look      Look?    @relation(fields: [lookId], references: [id], onDelete: SetNull)
  imageUrl  String
  // A render is a job: queued → rendering → ready | failed. The glass polls.
  status    String   @default("ready")
  error     String?
  // How it was made, for the record and for the cache.
  mode      String?
  model     String?
  prompt    String?
  key       String?
  // The usage event this render spent; refunded when it fails or is reported.
  // The reflection this render was made from; deleting it deletes this.
  photoPath String?
  usageEventId String?
  refunded  Boolean  @default(false)
  retryOf   String?
  reportedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, key])
  @@index([userId])
}

// A verdict poll: "which of these?" sent to friends via a public link.
// Results are visible only to the asker; every vote is labeled taste data.
model Poll {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question  String
  // [{ id: "a" | "b" | "c", imageUrl }]
  options   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  // Who it's asked of: circle (everyone who follows you) | friends (named) | link (only the page)
  audience    String   @default("circle")
  audienceIds String[] @default([])
  // Set once the asker (and voters) have been told the verdict is in.
  settledNotifiedAt DateTime?

  votes PollVote[]

  @@index([userId])
  // The settle tick: expired polls nobody has been told about yet.
  @@index([expiresAt, settledNotifiedAt])
}

model PollVote {
  id       String   @id @default(uuid())
  pollId   String
  poll     Poll     @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId String
  // Client-generated key so one browser votes once. Light-touch, not auth.
  voterKey String
  createdAt DateTime @default(now())

  @@unique([pollId, voterKey])
  @@index([pollId])
}

// Asymmetric social graph: follow anyone; mutual follows are "friends" and
// unlock collaborative features (picking outfits for each other).
model Follow {
  id          String   @id @default(uuid())
  followerId  String
  follower    User     @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User     @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// A friend assembled an outfit for you from your PUBLIC items.
model FriendPick {
  id        String   @id @default(uuid())
  forUserId String
  forUser   User     @relation("picksFor", fields: [forUserId], references: [id], onDelete: Cascade)
  byUserId  String
  byUser    User     @relation("picksBy", fields: [byUserId], references: [id], onDelete: Cascade)
  itemIds   String[]
  note      String?
  // The day it was picked for ("Saturday", "tonight", a date or an occasion).
  forDay      String?
  // The conversation back: thanks (with a line), the wear, the picker withdrawing it.
  thanksAt    DateTime?
  reply       String?
  wornLogId   String?
  wornAt      DateTime?
  withdrawnAt DateTime?
  createdAt DateTime @default(now())

  @@index([forUserId])
  @@index([byUserId])
}

// One row per AI-powered request, for per-user daily quotas and admin
// cost visibility. kind: tryon | looks | catalog
model UsageEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, kind, createdAt])
}

// Append-only audit of every gateway webhook we accepted. eventId makes
// webhook processing idempotent (gateways redeliver).
model BillingEvent {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  gateway   String
  eventType String
  eventId   String   @unique
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// The pre-composed outfit that greets the user each morning. One row per
// user per day; "another" regenerates payload in place. wornLogId links the
// one-tap wear so the evening card knows the day is settled.
model DailyBrief {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // YYYY-MM-DD in the user's day, client-supplied
  payload   Json
  // The day's occasion (resolved or chosen), rest days, and when it was laid
  // out (tonight, for tomorrow). The whole brief still lives in payload.
  eventType        String?
  rest             Boolean   @default(false)
  plannedAt        DateTime?
  weatherCheckedAt DateTime?
  wornLogId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  @@unique([userId, date])
}

// A saved trip: the packed capsule steers the daily brief while traveling.
model Trip {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  destination   String
  startDate     String // YYYY-MM-DD
  endDate       String // YYYY-MM-DD
  activities    String?
  packedItemIds String[]
  // The plan as composed: { rationale, essentials, forecast, days:[{label,note,itemIds}] }.
  plan          Json?
  // Checklist ticks, as "item-<id>" / "extra-<text>" keys.
  checked       String[] @default([])
  createdAt     DateTime @default(now())

  @@index([userId, startDate])
}

// A named set of Mirror renders ("Wedding options").
model Lookbook {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  tryOnIds  String[]
  createdAt DateTime @default(now())

  @@index([userId])
}

// Your reflections: up to three photos for the Mirror, each with consent
// recorded. User.photoPath points at the active one.
model UserPhoto {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path           String
  consentAt      DateTime
  consentVersion String   @default("v1")
  createdAt      DateTime @default(now())

  @@index([userId])
}
