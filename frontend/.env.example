# Base URL for the backend API.
# Defaults to "/api", which the Vite dev server proxies to http://localhost:3000.
# Override this only if your API is hosted elsewhere.
VITE_API_URL=/api

# Public origin for absolute Open Graph URLs (committed default lives in .env.production).
VITE_PUBLIC_ORIGIN=https://187.77.129.31.sslip.io
